---
/**
 * ニュース項目末尾の外部リンクアイコン
 */
export interface Props {
  href: string;
  ariaLabel?: string;
}

const { href, ariaLabel = '外部リンクを開く（別タブ）' } = Astro.props;
---

<a href={href} target="_blank" rel="noopener" aria-label={ariaLabel}>
  <svg class="ext-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
    <polyline points="15 3 21 3 21 9"/>
    <line x1="10" y1="14" x2="21" y2="3"/>
  </svg>
</a>
